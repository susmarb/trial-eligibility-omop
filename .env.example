# Copy to `.env` and edit. Every value has a working default; set only what
# differs on this machine. `trialcriteria config` prints what is actually in use.

# Where cached corpora, classifier output and the SQLite CDM live.
# TC_CACHE=.cache

# OHDSI vocabulary service. The default is the PUBLIC DEMO instance: it is rate
# limited and belongs to someone else. For bulk work, download the Athena
# vocabularies (free, registration required) and point this at your own WebAPI.
# TC_WEBAPI=https://atlas-demo.ohdsi.org/WebAPI

# An unpacked OMOP CDM in CSV form. `make cdm` puts the reference one here.
# TC_CDM_DIR=.cache/cdm/GiBleed_5.3

# The local classifier. Any module exposing load(model) -> agent.predict(...)
# works; see src/trialcriteria/classifier.py for the contract.
# TC_CLASSIFIER_MODULE=laya_mlx
# TC_CLASSIFIER_MODEL=aac6fef/laya-mlx

# If the classifier is installed in a DIFFERENT virtualenv from this package,
# point this at that environment's site-packages rather than merging the two.
# It must be an arm64 Python 3.12; a Rosetta python3 reports x86_64 and cannot
# install mlx.
# TC_CLASSIFIER_SITE_PACKAGES=/path/to/classifier-venv/lib/python3.12/site-packages

# Sent with every registry and vocabulary request. Put a real contact in it.
# TC_USER_AGENT=trial-eligibility-omop/0.1 (research; you@example.org)
